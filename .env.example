# ------------------------------------------------------------------
# Keystatic (panel /admin) – tryb GitHub w produkcji (Netlify).
#
# Tryb przełącza NEXT_PUBLIC_KEYSTATIC_MODE (jedyna zmienna widoczna
# dla przeglądarki, bo konfiguracja Keystatic jest oceniana też po
# stronie klienta). Skopiuj te zmienne do ustawień Netlify (Site
# settings → Environment variables) oraz do pliku .env lokalnie.
#
# Wartości generuje kreator Keystatic: przy `next dev` wejdź na
# /admin/setup → "Create GitHub App" → kreator dopisuje blok "# Keystatic"
# do .env. Szczegóły: https://keystatic.com/docs/github-mode
# ------------------------------------------------------------------

# Włącza tryb "github" (repo: Igorchpolak/St-Christopher).
# Bez tej zmiennej panel działa w trybie "local" (zapis do src/content/).
NEXT_PUBLIC_KEYSTATIC_MODE=github

# Aplikacja GitHub utworzona przez kreatora
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=

# Losowy sekret do podpisywania sesji (np. `openssl rand -hex 32`)
KEYSTATIC_SECRET=

# Slug aplikacji GitHub (widoczny w Keystatic Cloud po utworzeniu aplikacji)
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# ------------------------------------------------------------------
# Adres produkcyjny serwisu (używany przez sitemap i kanoniczne URL-e).
# ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://twoja-domena.pl
