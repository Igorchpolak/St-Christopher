# ------------------------------------------------------------------
# Keystatic (CMS) – aktualna konfiguracja projektu.
#
# Panel działa lokalnie (tryb "local", wpisane na sztywno w
# keystatic.config.ts): npm run dev → http://localhost:3000/keystatic.
# Publikacja zmian: commit + push do GitHub → rebuild Netlify.
#
# Poniższe zmienne będą potrzebne dopiero po naprawie buga
# Thinkmill/keystatic#1549 (tryb "github" – edycja bezpośrednio
# na serwerze; patrz komentarz w keystatic.config.ts).
#
# Wartości generuje kreator Keystatic: https://keystatic.com/docs/github-mode
# ------------------------------------------------------------------
# NEXT_PUBLIC_KEYSTATIC_MODE=github
# KEYSTATIC_GITHUB_CLIENT_ID=
# KEYSTATIC_GITHUB_CLIENT_SECRET=
# KEYSTATIC_SECRET=
# NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# ------------------------------------------------------------------
# Adres produkcyjny serwisu (używany przez sitemap i kanoniczne URL-e).
# ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://twoja-domena.pl
